// ============================================================================
// Sync Product 到 Books（只查找，不创建不更新）
// 逻辑：
// 1. CRM 已有 Books_Item_ID → 直接返回
// 2. 用 CRM Internal_ID 匹配 Books Item 的 cf_netsuite_id → 返回 ID + 回写 CRM
// 3. 没有匹配 → 返回 null（SO 将跳过）
// ============================================================================

string standalone.SyncProductToBooks(productId)
{
    // Step 1: CRM 已有 Books_Item_ID → 直接返回
    product = zoho.crm.getRecordById("Products", productId);
    crmBooksItemId = product.get("Books_Item_ID");
    if(crmBooksItemId != null && crmBooksItemId != "")
    {
        return crmBooksItemId;
    }

    // Step 2: 用 Internal_ID 匹配 Books Item 的 cf_netsuite_id
    internalId = product.get("Internal_ID");
    if(internalId == null || internalId == "")
    {
        info ">> No Internal_ID for Product: " + productId;
        return null;
    }

    config = standalone.GetBooksConfig().toMap();
    baseUrl = config.get("baseUrl");
    orgId = config.get("organizationId");

    searchResponse = invokeurl
    [
        url: baseUrl + "/items?organization_id=" + orgId + "&cf_netsuite_id=" + encodeUrl(internalId.toString())
        type: GET
        connection: "books"
    ];

    if(searchResponse.get("code") == 0)
    {
        items = searchResponse.get("items");
        if(items != null && items.size() > 0)
        {
            itemId = items.get(0).get("item_id");
            info ">> Found by cf_netsuite_id=" + internalId + ": " + itemId;
            // 回写 CRM
            updateMap = Map();
            updateMap.put("Books_Item_ID", itemId);
            zoho.crm.updateRecord("Products", productId.toString(), updateMap);
            return itemId;
        }
    }

    // 没有匹配 → 返回 null
    info ">> No match in Books for cf_netsuite_id: " + internalId;
    return null;
}
