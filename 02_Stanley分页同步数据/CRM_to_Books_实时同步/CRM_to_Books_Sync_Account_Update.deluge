// ============================================================================
// Sync Account 到 Books（只查找，不创建不更新）
// 逻辑：
// 1. CRM 已有 Books_Customer_ID → 直接返回
// 2. Books 中按 Account Name 精确匹配 Customer Name → 返回 ID + 回写 CRM
// 3. 没有精确匹配 → 返回 null（SO 将跳过）
// ============================================================================

string standalone.SyncAccountToBooks(accountId)
{
    account = zoho.crm.getRecordById("Accounts", accountId);
    accountName = account.get("Account_Name");

    config = standalone.GetBooksConfig().toMap();
    baseUrl = config.get("baseUrl");
    orgId = config.get("organizationId");

    info "========================================";
    info "Sync Account: " + accountName;

    // Step 1: CRM 已有 Books_Customer_ID → 直接返回
    crmBooksId = account.get("Books_Customer_ID");
    info "[DEBUG] CRM Books_Customer_ID = '" + crmBooksId + "'";
    if(crmBooksId != null && crmBooksId != "")
    {
        info ">> Skip (already synced): " + crmBooksId;
        return crmBooksId;
    }

    // Step 2: 按 Account Name 精确匹配
    existingCustomerId = null;
    if(accountName != null && accountName != "")
    {
        searchResp = invokeurl
        [
            url: baseUrl + "/contacts?organization_id=" + orgId + "&search_text=" + encodeUrl(accountName)
            type: GET
            connection: "books"
        ];
        // Rate limit check
        respMsg = searchResp.get("message");
        if(respMsg != null && (respMsg.contains("rate limit") || respMsg.contains("maximum call rate")))
        {
            info "[RATE_LIMIT] Books API rate limit during account search";
            return "rate_limited";
        }
        if(searchResp.get("code") == 0)
        {
            contacts = searchResp.get("contacts");
            if(contacts != null && contacts.size() > 0)
            {
                for each contact in contacts
                {
                    contactName = contact.get("contact_name");
                    // 名称精确匹配才认
                    if(contactName != null && contactName.equalsIgnoreCase(accountName))
                    {
                        existingCustomerId = contact.get("contact_id");
                        info ">> Found by name (exact): " + existingCustomerId;
                        break;
                    }
                }
            }
        }
    }

    // 匹配到 → 回写 CRM + 返回 ID
    if(existingCustomerId != null)
    {
        updateMap = Map();
        updateMap.put("Books_Customer_ID", existingCustomerId);
        zoho.crm.updateRecord("Accounts", accountId.toString(), updateMap);
        return existingCustomerId;
    }

    // 没有精确匹配 → 返回 null，SO 将跳过此客户
    info ">> No exact match in Books for: " + accountName;
    return null;
}
