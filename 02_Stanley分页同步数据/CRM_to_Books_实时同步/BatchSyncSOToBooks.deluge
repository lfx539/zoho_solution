// ============================================================================
// 从 CRM 同步 SO 到 Books（按日期过滤，批量同步）
// 用途：同步 2026-07-01 之后的 Sales Orders 到 Zoho Books（仅 SO）
// 每次执行处理 100 条，不需要 offset，直接查 Books_SO_ID is null
// ============================================================================

void schedule.BatchSyncSOToBooks()
{
	startDate = "2026-07-01";
	successCount = 0;
	failCount = 0;

	// COQL 查询未同步的 SO（Books_SO_ID 为空）
	coqlQuery = "select id from Sales_Orders where Date >= '" + startDate + "' and Books_SO_ID is null order by Date asc limit 100";
	requestParams = Map();
	requestParams.put("select_query", coqlQuery);
	coqlResp = invokeurl
	[
		url :"https://www.zohoapis.com.au/crm/v8/coql"
		type :POST
		parameters:requestParams.toString()
		connection:"crm"
	];

	if(coqlResp == null)
	{
		info "[ERR] COQL查询失败";
		return;
	}

	errorCode = coqlResp.get("code");
	if(errorCode != null && errorCode != "SUCCESS" && errorCode != "0")
	{
		info "[ERR] COQL Error: " + errorCode + " - " + coqlResp.get("message");
		return;
	}

	dataList = coqlResp.get("data");
	if(dataList == null || dataList.size() == 0)
	{
		info "没有符合条件的数据，同步完成";
		return;
	}

	info "COQL 返回 " + dataList.size() + " 条待同步 SO";

	// 逐条处理
	rateLimited = false;
	for each soRecord in dataList
	{
		soId = soRecord.get("id");
		if(soId == null || soId == "")
		{
			continue;
		}

		try
		{
			syncResultStr = standalone.SyncSalesOrderToBooks(soId.toString());
			syncResult = syncResultStr.toMap();

			syncStatus = syncResult.get("status");

			// Rate limit: 立即终止批处理
			if(syncStatus == "rate_limited")
			{
				rateLimited = true;
				failCount = failCount + 1;
				remainingCount = dataList.size() - successCount - failCount;
				info "[RATE_LIMIT] Books API 限流，终止批处理。剩余 " + remainingCount + " 条待下次执行";
				break;
			}

			if(syncStatus == "success" || syncStatus == "partial")
			{
				successCount = successCount + 1;
			}
			else
			{
				failCount = failCount + 1;
				syncError = syncResult.get("error");
				info "[ERR] SO " + soId + " - " + syncError;
			}
		}
		catch(e)
		{
			failCount = failCount + 1;
			info "[ERR] Exception: SO " + soId + " - " + e;
		}
	}

	// 输出结果
	info "===== 本批完成 成功:" + successCount + " 失败:" + failCount + " =====";
	if(rateLimited)
	{
		info "⚠ Books API 限流 (10,000 calls/day)，请明天配额重置后再执行";
	}
	else if(dataList.size() == 100)
	{
		info "还有更多数据待同步，请继续执行";
	}
	else
	{
		info "全部同步完成";
	}
}
